# Copy this file to .env and fill in the values from your Meta app.
# Never commit .env — it contains your app secret.

# Meta app credentials (developers.facebook.com → your app → App ID / App secret)
IG_APP_ID=your_app_id
IG_APP_SECRET=your_app_secret

# OAuth redirect URI registered in the Meta app (localhost is allowed for development)
IG_REDIRECT_URI=http://localhost:3000/auth/callback

# Comma-separated OAuth scopes. Defaults target the "Instagram API with Instagram login" product.
# Reading follower/following lists requires a Business or Creator Instagram account.
IG_SCOPES=instagram_business_basic,instagram_business_manage_insights

# Graph API version and host (Instagram login tokens use graph.instagram.com)
IG_API_VERSION=v21.0
# IG_GRAPH_HOST=https://graph.instagram.com

# Server bind address — keep it local. Do NOT set HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000
